# Copie para .env e preencha. NUNCA commite o .env: o repositório é público.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Banco. Local: npm run db:local (PGlite, sem instalar nada). Produção: string do Neon.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"

# Auth.js. Gere com: npx auth secret   (ou node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# Endereço público do app (links dos e-mails). Local: http://localhost:3000
APP_URL="http://localhost:3000"

# Chave de 32 bytes em base64 para cifrar o token da Nuvemshop, CPF e Pix.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRIPTO_CHAVE=""

# Segredo que a Vercel Cron manda no cabeçalho Authorization.
CRON_SECRET=""

# Vercel Blob (upload de vídeos). Sem ele, o upload responde "indisponível".
BLOB_READ_WRITE_TOKEN=""

# Resend (e-mails). Sem a chave, os e-mails aparecem no terminal.
RESEND_API_KEY=""
EMAIL_REMETENTE="WEECREA <nao-responda@seu-dominio.com.br>"

# Nuvemshop (Portal de Parceiros). Usados pelo M3 e pelo M4.
NUVEMSHOP_APP_ID=""
NUVEMSHOP_CLIENT_SECRET=""
NUVEMSHOP_USER_AGENT="WEECREA (contato@seu-dominio.com.br)"

# Senha das pessoas de exemplo criadas pelo seed. No banco local, sem valor, usa a padrão do seed.
SENHA_EXEMPLO=""
